# Copy to .env for Docker Compose only. PHP itself reads process environment variables.
# Set every variable in the hosting dashboard for production. Never commit real secrets.
APP_ENV=development
APP_URL=http://localhost:8080
APP_DEMO=1

DB_HOST=db
DB_PORT=3306
DB_NAME=burger_house
DB_USER=bh_web
DB_PASSWORD=local-demo-change-me
DB_SSL_REQUIRED=0
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=10
# For production remote MySQL use DB_SSL_REQUIRED=1 and a trusted CA, path OR base64.
DB_SSL_CA=
DB_SSL_CA_BASE64=

SESSION_DRIVER=mysql
SESSION_TTL_SECONDS=43200
# Production always issues Secure cookies. Use 0 only for local HTTP.
SESSION_COOKIE_SECURE=0
ADMIN_USER=admin
# Paste the complete password_hash output. In .env wrap bcrypt hashes in single quotes.
ADMIN_PASSWORD_HASH=
OPERATOR_USER=
OPERATOR_PASSWORD_HASH=
STORE_PICKUP_ADDRESS=
# Optional Brazilian number with DDD (e.g. 11912345678). No fictitious contact is published.
STORE_CONTACT_PHONE=

# Caddy only accepts forwarded client IPs from these upstream addresses/CIDRs.
# Replace with the trusted ingress ranges for your deployment; never use 0.0.0.0/0.
TRUSTED_PROXIES=127.0.0.1/32 ::1/128

# Local Docker database owner, only used by Compose/migrations (never by the web service).
MYSQL_ROOT_PASSWORD=local-root-change-me
