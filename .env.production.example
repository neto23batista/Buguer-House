# Reference for the hosting dashboard or docker run --env-file.
# Copy to .env.production and fill the empty values. PHP does not load this file.
# Keep real credentials out of Git. docker run --env-file uses values WITHOUT quotes.
APP_ENV=production
# Public HTTPS origin, without path or trailing slash.
APP_URL=

# Dedicated production database. Do not use the integration/browser test database.
DB_HOST=
DB_PORT=3306
DB_NAME=burger_house
DB_USER=bh_web
DB_PASSWORD=
DB_SSL_REQUIRED=1
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=10
# Use the image's system CAs, or supply ONE trusted CA option below.
DB_SSL_CA=
DB_SSL_CA_BASE64=

SESSION_DRIVER=mysql
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=1
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# Optional environment-based operator; individual logins can be created in Equipe.
OPERATOR_USER=
OPERATOR_PASSWORD_HASH=

# Configure the actual address and opening hours in Loja before unpausing.
STORE_PICKUP_ADDRESS=
# Actual Brazilian contact number including DDD.
STORE_CONTACT_PHONE=
# Set to the deployment's trusted ingress addresses/CIDRs.
TRUSTED_PROXIES=127.0.0.1/32 ::1/128

# Required for the scheduled HTTP maintenance endpoint: random secret, 32+ characters.
CRON_SECRET=
MAINTENANCE_BATCH_SIZE=500
MAINTENANCE_MAX_BATCHES=20
MAINTENANCE_MAX_SECONDS=10
# Set only after choosing the store's retention period for completed/cancelled orders.
ORDER_PII_RETENTION_DAYS=0
